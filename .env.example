# ERPNext UAT (server-side only — never exposed to the browser)
ERPNEXT_URL=https://your-uat-site.example.com
ERPNEXT_API_KEY=xxxxxxxxxxxxxxx
ERPNEXT_API_SECRET=xxxxxxxxxxxxxxx

# Google Drive (server-side only). Pick ONE auth mode:
#   A) Service account (private folder): paste the full key JSON as one line,
#      then share the Drive folder with the service account's client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
#   B) API key (folder must be "anyone with link can view"):
GOOGLE_DRIVE_API_KEY=

# The Drive folder holding the monthly .xlsx sheets (id from its share URL)
GOOGLE_DRIVE_FOLDER_ID=
